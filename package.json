{
  "name": "ai-agent-poc-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AI Agent POC with React UI and backend",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/frontend",
    "dev:api": "npm run dev:api --workspace=packages/backend",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=packages/backend",
    "build:frontend": "npm run build --workspace=packages/frontend",
    "start:api": "npm run start:api --workspace=packages/backend",
    "start:backend": "npm start --workspace=packages/backend"
  },
  "keywords": [
    "ai",
    "agent",
    "react",
    "mcp",
    "monorepo"
  ],
  "author": "",
  "license": "MIT"
}

