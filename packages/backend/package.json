{
    "name": "@ai-agent-poc/backend",
    "version": "1.0.0",
    "description": "TypeScript agent system using Model Context Protocol (MCP) SDK",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "start:api": "node dist/server.js",
        "dev": "tsx src/index.ts",
        "dev:api": "tsx src/server.ts",
        "test": "node --test dist/test.js"
    },
    "keywords": [
        "mcp",
        "agent",
        "typescript",
        "llm"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@ai-sdk/openai": "1.3.23",
        "@modelcontextprotocol/sdk": "1.15.1",
        "ai": "4.3.17",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "17.2.0",
        "express": "^5.1.0",
        "express-validator": "^7.3.0",
        "helmet": "^8.1.0",
        "node-fetch": "^3.3.2",
        "pg": "^8.11.3",
        "uuid": "^13.0.0",
        "zod": "3.23.8"
    },
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/node": "24.0.13",
        "@types/pg": "^8.10.9",
        "@types/uuid": "^10.0.0",
        "tsx": "^4.6.2",
        "typescript": "^5.3.3"
    }
}
