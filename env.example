# LLM Configuration
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=your-model-name

# Agent Configuration
AGENT_NAME=test-agent
AGENT_VERSION=1.0.0
AGENT_MAX_ITERATIONS=8
AGENT_DEBUG=true

# Optional LLM Settings
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=30000

# PostgreSQL Database Configuration
# Leave unset to disable. If set, enables cross-database queries.

# Core Service Database
POSTGRES_CORE_SERVICE_HOST=localhost
POSTGRES_CORE_SERVICE_PORT=5432
POSTGRES_CORE_SERVICE_DB=testdb
POSTGRES_CORE_SERVICE_USER=testuser
POSTGRES_CORE_SERVICE_PASSWORD=testpass
POSTGRES_CORE_SERVICE_SSL=false
POSTGRES_CORE_SERVICE_MAX_RETRIES=3

# External Partner Service Database
POSTGRES_EXTERNAL_PARTNER_SERVICE_HOST=localhost
POSTGRES_EXTERNAL_PARTNER_SERVICE_PORT=5431
POSTGRES_EXTERNAL_PARTNER_SERVICE_DB=testdb2
POSTGRES_EXTERNAL_PARTNER_SERVICE_USER=testuser
POSTGRES_EXTERNAL_PARTNER_SERVICE_PASSWORD=testpass
POSTGRES_EXTERNAL_PARTNER_SERVICE_SSL=false
POSTGRES_EXTERNAL_PARTNER_SERVICE_MAX_RETRIES=3

API_PORT=3001
API_HOST=localhost
CORS_ORIGIN=http://localhost:5173
