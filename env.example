# LLM Configuration
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=your-model-name

# Agent Configuration
AGENT_NAME=test-agent
AGENT_VERSION=1.0.0
AGENT_MAX_ITERATIONS=8
AGENT_DEBUG=true

# Optional LLM Settings
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=30000

# PostgreSQL Database Configuration
# Databases are dynamically discovered from environment variables. You can configure multiple databases.
# The system automatically discovers all configured databases and makes them available for queries.
#
# Note: Legacy variable names (POSTGRES_*, POSTGRES2_*) are still supported for backward compatibility,
# but the new naming convention (POSTGRES_CORE_SERVICE_*, POSTGRES_EXTERNAL_PARTNER_SERVICE_*) is recommended.

# Core Service Database (always configured)
POSTGRES_CORE_SERVICE_HOST=localhost
POSTGRES_CORE_SERVICE_PORT=5432
POSTGRES_CORE_SERVICE_DB=testdb
POSTGRES_CORE_SERVICE_USER=testuser
POSTGRES_CORE_SERVICE_PASSWORD=testpass
POSTGRES_CORE_SERVICE_SSL=false
POSTGRES_CORE_SERVICE_MAX_RETRIES=3

# External Partner Service Database (optional)
# Leave unset to disable. If set, enables cross-database queries.
POSTGRES_EXTERNAL_PARTNER_SERVICE_HOST=localhost
POSTGRES_EXTERNAL_PARTNER_SERVICE_PORT=5431
POSTGRES_EXTERNAL_PARTNER_SERVICE_DB=testdb2
POSTGRES_EXTERNAL_PARTNER_SERVICE_USER=testuser
POSTGRES_EXTERNAL_PARTNER_SERVICE_PASSWORD=testpass
POSTGRES_EXTERNAL_PARTNER_SERVICE_SSL=false
POSTGRES_EXTERNAL_PARTNER_SERVICE_MAX_RETRIES=3

# Additional Databases (optional)
# You can add more databases using the pattern: POSTGRES_<NAME>_HOST, POSTGRES_<NAME>_DB, etc.
# Example for a third database named "analytics":
# POSTGRES_ANALYTICS_HOST=localhost
# POSTGRES_ANALYTICS_PORT=5433
# POSTGRES_ANALYTICS_DB=analyticsdb
# POSTGRES_ANALYTICS_USER=testuser
# POSTGRES_ANALYTICS_PASSWORD=testpass
# POSTGRES_ANALYTICS_SSL=false
# POSTGRES_ANALYTICS_MAX_RETRIES=3
# 
# The database name will be automatically converted to lowercase with hyphens (e.g., "analytics").
# Use database_source="analytics" in tools to query this database.
# For cross-database queries, prefix table names with the database name: "analytics:table_name" 

API_PORT=3001
API_HOST=localhost
CORS_ORIGIN=http://localhost:5173
